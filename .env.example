# Radar / Beeclaw local runtime
RADAR_BASE_URL=http://127.0.0.1:8780
RADAR_HOST=127.0.0.1
RADAR_PORT=8780
# Optional. If unset, scripts use $HOME/.radar-venv.
RADAR_VENV_DIR=
# Optional locally; required for production-facing API deployments.
# When set, /api/* requests must send Authorization: Bearer <token>
# or X-Radar-API-Token. Use platform Secret management for real values.
RADAR_API_TOKEN=

# Beeclaw X auto route
# Recommended default: auto. Radar chooses x_mcp -> x_api -> twitterapi_io -> x_rss -> browser-session backends.
BEECLAW_X_MODE=auto

# X official/API-style credentials. Do not commit real values.
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_READ_ONLY=true

# X MCP backend, usually managed by the Agent runtime / MCP Manager in production.
XMCP_SERVER_URL=http://127.0.0.1:8000/mcp
X_API_TOOL_ALLOWLIST=getUsersByUsername,getUsersPosts,getUsersIdPosts,getPosts,searchPostsRecent,getPostsById,getPostsByIds,getUsage

# Platform MCP Gateway mode. Production platforms inject these values.
RADAR_BACKEND_MCP_MODE=
MCP_MANAGER_NAME=platform-mcp-manager
MCP_MANAGER_DISPLAY_NAME=Platform MCP Manager
MCP_MANAGER_MANAGED_BY=platform_runtime
MCP_GATEWAY_URL=
MCP_WORKSPACE_ID=
MCP_RUNTIME_TOKEN=

# X browser-session fallback. Use cloud/headless/local.
BEECLAW_X_BROWSER_SESSION_MODE=auto

# Cloud Browser / Browserbase / self-hosted browser worker.
BEECLAW_X_BROWSER_ENDPOINT=
BEECLAW_X_BROWSER_API_KEY=
BEECLAW_X_BROWSER_PROVIDER=browserbase

# Headless browser command. The command must output JSON with items/tweets.
BEECLAW_X_BROWSER_CMD=
BEECLAW_X_BROWSER_PROFILE_DIR=
BEECLAW_X_BROWSER_COOKIES_PATH=
BEECLAW_X_BROWSER_STORAGE_STATE=
BEECLAW_X_BROWSER_TIMEOUT=60

# Local WebBridge fallback for development with a logged-in browser session.
WEBBRIDGE_URL=http://127.0.0.1:10086

# Optional generic rendered-page backend.
BEECLAW_AGENT_BROWSER_ENDPOINT=
BEECLAW_AGENT_BROWSER_API_KEY=
BEECLAW_AGENT_BROWSER_CMD=
AGENT_BROWSER_MODE=headless
AGENT_BROWSER_HEADLESS=true

# Optional CLI backend overrides.
BEECLAW_XHS_CLI_CMD=
BEECLAW_RDT_CLI_CMD=
BEECLAW_TWITTER_CLI_BIN=
