# Copy this file to tools/xmcp/.env and fill values from X Developer Console.
# Do not commit real secrets.

# X Developer App credentials
X_OAUTH_CONSUMER_KEY=
X_OAUTH_CONSUMER_SECRET=
X_BEARER_TOKEN=
X_AUTH_MODE=bearer

# Read-only tool allowlist for Radar content crawling.
X_API_TOOL_ALLOWLIST=getUsersByUsername,getUsersPosts,searchPostsRecent,getPostsById,getPostsByIds,getUsage

# X API / XMCP server settings
X_API_BASE_URL=https://api.x.com
X_API_TIMEOUT=30
X_API_DEBUG=1
MCP_HOST=127.0.0.1
MCP_PORT=8000

# OAuth1 callback used by XMCP startup flow.
# Register this callback URL in the X Developer App:
# http://127.0.0.1:8976/oauth/callback
X_OAUTH_CALLBACK_HOST=127.0.0.1
X_OAUTH_CALLBACK_PORT=8976
X_OAUTH_CALLBACK_PATH=/oauth/callback
X_OAUTH_CALLBACK_TIMEOUT=300

# Radar crawler uses this endpoint when --mode xmcp is selected.
XMCP_SERVER_URL=http://127.0.0.1:8000/mcp
